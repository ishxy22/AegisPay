# ==============================================================================
# AEGISPAY ENVIRONMENT CONFIGURATION
# Fill in your real API keys below to activate live PayPal Sandbox & AI features.
# If left blank, AegisPay will automatically run in high-fidelity Demo / Simulation mode!
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal Developer Sandbox Credentials
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_placeholder
PAYPAL_CLIENT_ID=your_paypal_client_id_placeholder
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_placeholder
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_placeholder
PAYPAL_ENVIRONMENT=sandbox
# Options: sandbox (default) or live

# Google Gemini API (Multimodal Deliverable Inspection & Milestone Extraction)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-2.5-flash

# Groq API (High-Speed Llama 3 Mediation & Dispute Reasoning)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_placeholder
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase PostgreSQL & Storage (Optional: in-memory / local fallback active if unset)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
STORAGE_BUCKET=aegispay-evidence

# GitHub API Token (Optional: for inspecting repository commits & pull requests)
GITHUB_TOKEN=your_github_token_placeholder

# Bryntum Gantt Commercial License Key (Optional: interface fallback active if unset)
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=your_bryntum_license_key_placeholder
